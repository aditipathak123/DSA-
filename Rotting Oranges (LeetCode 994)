class Solution {
public:
    int orangesRotting(vector<vector<int>>& grid) {
        int n = grid.size(), m = grid[0].size();
        queue<pair<int,int>> q;
        int fresh = 0;

        // Step 1: initial state
        for(int i = 0; i < n; i++){
            for(int j = 0; j < m; j++){
                if(grid[i][j] == 2){
                    q.push({i,j});
                }
                else if(grid[i][j] == 1){
                    fresh++;
                }
            }
        }

        int time = 0;
        vector<pair<int,int>> dir = {{1,0},{-1,0},{0,1},{0,-1}};

        // Step 2: BFS
        while(!q.empty() && fresh > 0){
            int size = q.size();
            time++;

            while(size--){
                auto [x,y] = q.front();
                q.pop();

                for(auto d : dir){
                    int nx = x + d.first;
                    int ny = y + d.second;

                    if(nx>=0 && ny>=0 && nx<n && ny<m && grid[nx][ny]==1){
                        grid[nx][ny] = 2;
                        q.push({nx,ny});
                        fresh--;
                    }
                }
            }
        }

        return (fresh == 0) ? time : -1;
    }
};
